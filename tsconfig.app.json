{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": []
  },
  // 画面のコードは DOM の型を使うため、そのテストもここで検査する。
  // ただしテストの実行環境は node（vite.config.ts）。DOM を実際に触るテストを
  // 書くときは、そこで環境（jsdom など）を足すこと
  "include": ["src/core/**/*.ts", "src/app/**/*.ts", "src/app/**/*.vue"],
  "exclude": ["src/core/**/*.test.ts", "src/**/*.node.ts"]
}
