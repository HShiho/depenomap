{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    // Vite の設定ファイルは Node が直接読む（型を剥がすだけ）ため、そこから辿る
    // 相対 import は拡張子付きで書く必要がある。それを許可する
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  // core とサーバーのテストはここが見る（それぞれの include に含まれる）。
  // 画面のテストは DOM を使うため tsconfig.app.json 側で検査する
  "include": ["src/core/**/*.ts", "src/server/**/*.ts", "src/**/*.node.test.ts", "vite.config.ts"]
}
